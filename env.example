# Copy this file to ".env" in the same folder as audio_exporter.py,
# fill in real values, then run:  chmod 600 .env
# NEVER commit the real .env file.

# --- SFTP server the finished mp3 is uploaded to ---
SFTP_HOST=files.example.org
# SFTP_PORT=22
SFTP_USERNAME=my_user_name
SFTP_PASSWORD=my_password
# Folder on the server that receives the mp3 files
SFTP_REMOTE_DIR=/home/my_user_name/www
# Copy of the newest service, overwritten each week (optional)
# LATEST_FILENAME=Current_Service.mp3

# --- Report emails ---
# Gmail account that sends the reports. EMAIL_PASS must be a 16-character
# Google App Password, not your normal password (requires 2-Step
# Verification). Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=my.church@gmail.com
EMAIL_PASS=my_app_password
# Who receives the reports (comma-separated)
EMAIL_TO=person1@example.org,person2@example.org

# --- Naming (optional) ---
# Used in email subjects, the window title and the mp3 Album/Artist tags
ORG_NAME=My Church
# The year folder is Music/<FOLDER_PREFIX><year>, for example Music/MyChurch_2026
FOLDER_PREFIX=MyChurch_
# How many days back to look for a dated WAV file (default 6)
# DAYS_TO_CHECK=6

# --- Output drive ---
# Mount point of the permanent output drive (see SETUP_NOTES.md, section 2)
OUTPUT_PATH=/mnt/church_music
